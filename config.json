{
  "general": { 
    "dataset": "MC",
    "operation_mode":"Analysis",
    "verbose": 1,
    "visualize":true
  },
  
  "io": {
    "tree_data_name":"Events",
    "in_data_file":"../data/dati0.root",
    "tree_mc_name":"Events",
    "in_mc_file":"../data/datiMC0.root",
    "val_file":"../data/validation_muon_run.json"
  },

  "selection": {
    "selection_mode": "TagAndProbe",
    "save_sel_plots":true,
    "save_sel_data":true,
    "visual_sel":false,
    "o_sel_file_plots":"../output/risultati_plots.root",
    "o_sel_file_data":"../output/risultati_data.root"
  },

  "template": {
    "bins_settup":"0_Set_Pt4_Eta4_Mll70",
    "template_type":"HISTO_DATA",
    "o_template_file_data":"../output/risultati_template.root",
    "pt_bins": [25.0, 30.0, 35.0, 40.0, 50.0],
    "eta_bins": [-2.4, -0.9, 0.0, 0.9, 2.4],
    "mll_bins": 70.0
  },
  
  "analysis": {
    "pre_fit":true,
    "o_fit_file":"../output/risultati_fit.root",
    "sample_pass_data":"histo",
    "sample_pass_mc":"histo",
    "sample_fail_data":"histo",
    "sample_fail_mc":"data",
    "params": {
      "efficiency":[0.9, 0.4, 1.0],
      "n_tot":[0,0,0],
      "mu":[-0.08, -3.0, 3.0],
      "sigma":[0.1, 0.001, 2.0],
      "lambda_pass":[-0.04, -3.0, 0.0],
      "lambda_fail":[-0.04, -3.0, 0.0]
    }
  },

  "flag_TP": {
    "en_kinematics":true,
    "en_mass_window":true
  },

  "cut_TP": {
    "pt_cut":25.0,
    "eta_cut":2.4,
    "iso_cut":0.15,
    "mass_min":60.0,
    "mass_max":120.0
  },

  "flag_RM": {
    "en_kinematics":true,
    "en_isolation":false,
    "en_mass_window":false,
    "en_tight_muon":false
  },

  "cut_RM": {
    "pt_cut":25.0,
    "eta_cut":2.5,
    "iso_cut":0.15,
    "mass_min":60.0,
    "mass_max":120.0
  },

  "plot": {
    "pt":{
      "title_axis":"p_t [GeV]",
      "axis_min":25.0,
      "axis_max":100.0,
      "nbins":100
    },
    "eta":{
      "title_axis":"#eta",
      "axis_min":-2.4,
      "axis_max":2.4,
      "nbins":100
    },
    "mll": {
      "title_axis": "m_{#mu#mu} [GeV]",
      "axis_min": 60.0,
      "axis_max": 120.0,
      "nbins": 100
    },
    "canvas":{
      "width":800,
      "height":600
    }
  }
}