{
  "general": { 
    "dataset": "MC",
    "operation_mode":"Analysis",
    "verbose": 1,
    "visualize":true
  },
  
  "io": {
    "tree_data_name":"Events",
    "in_data_file":"../data/dati0.root",
    "tree_mc_name":"Events",
    "in_mc_file":"../data/datiMC0.root",
    "val_file":"../data/validation_muon_run.json"
  },

  "selection": {
    "selection_mode": "TagAndProbe",
    "save_sel_plots":false,
    "save_sel_data":false,
    "visual_sel":false,
    "o_sel_file_plots":"../output/risultati_plots.root",
    "o_sel_file_data":"../output/risultati_data.root"
  },

  "analysis": {
    "bins_settup":"Settup_3_Pt4_Eta8",
    "o_template_file_data":"../output/risultati_template.root",
    "pt_bins": [25.0, 30.0, 35.0, 40.0, 50.0],
    "eta_bins": [-2.4, -1.8, -1.2, -0.6, 0.0, 0.6, 1.2, 1.8, 2.4],
    "mll_bins": 50.0
  },

  "flag_TP": {
    "en_kinematics":true,
    "en_mass_window":true
  },

  "cut_TP": {
    "pt_cut":25.0,
    "eta_cut":2.4,
    "iso_cut":0.15,
    "mass_min":60.0,
    "mass_max":120.0
  },

  "flag_RM": {
    "en_kinematics":true,
    "en_isolation":false,
    "en_mass_window":false,
    "en_tight_muon":false
  },

  "cut_RM": {
    "pt_cut":25.0,
    "eta_cut":2.5,
    "iso_cut":0.15,
    "mass_min":60.0,
    "mass_max":120.0
  },

  "plot": {
    "pt":{
      "title_axis":"p_t [GeV]",
      "axis_min":25.0,
      "axis_max":100.0,
      "nbins":100
    },
    "eta":{
      "title_axis":"#eta",
      "axis_min":-2.4,
      "axis_max":2.4,
      "nbins":100
    },
    "mll": {
      "title_axis": "m_{#mu#mu} [GeV]",
      "axis_min": 60.0,
      "axis_max": 120.0,
      "nbins": 100
    },
    "canvas":{
      "width":800,
      "height":600
    }
  }
}